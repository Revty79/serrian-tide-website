DATABASE_URL=postgresql://serrian_tide_app:replace-with-db-password@localhost:5432/serrian_tide_dev
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
# Optional additional exact origins (scheme, host and port), comma-separated.
# BETTER_AUTH_URL remains trusted. List each local-IP or tunnel origin explicitly;
# do not use wildcard domains. Whitespace and empty entries are ignored.
# Example: http://192.0.2.10:3000,https://your-specific-tunnel.trycloudflare.com
BETTER_AUTH_TRUSTED_ORIGINS=

# Recovery protection: permanent deletion remains disabled in production unless
# an operator deliberately sets this exact server-only value to true.
SERRIAN_TIDE_ENABLE_PERMANENT_DELETION=false
