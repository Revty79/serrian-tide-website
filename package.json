{
  "name": "serrian-tide-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:canon": "node scripts/import-ststandalone-canon.mjs --validate-only",
    "validate:campaign": "tsx --test src/features/campaigns/*.test.ts",
    "validate:creatures": "tsx --test src/features/creatures/*.test.ts",
    "validate:creature-ability": "tsx --test src/features/creatures/creature-ability.test.ts",
    "validate:derived-abilities": "tsx --test src/features/derived-abilities/*.test.ts",
    "validate:baseline": "node scripts/verify-squashed-baseline.mjs",
    "validate:character": "tsx --test src/features/characters/character-creation.test.ts src/features/characters/attribute-reference.test.ts src/features/characters/character-attribute-card.test.ts src/features/characters/character-print.test.ts",
    "validate:chat": "tsx --test src/features/chat/*.test.ts",
    "validate:chat-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/chat-foundation-db.test.ts scripts/chat-room-foundation-db.test.ts scripts/chat-service-db.test.ts",
    "validate:chat-browser": "node --import tsx --test scripts/chat-interface-browser.test.ts",
    "validate:chat-live-browser": "node --import tsx scripts/chat-live-browser.test.ts",
    "validate:magic": "tsx --test src/features/characters/character-spell-casting.test.ts src/features/characters/magic-context-parity.test.ts",
    "validate:navigation": "tsx --test src/features/navigation/*.test.ts src/features/campaigns/campaign-membership.test.ts src/features/campaigns/campaign-workflow.test.ts",
    "validate:crossroads-navigation-browser": "node --import tsx scripts/crossroads-navigation-browser.test.ts",
    "validate:tabletop": "tsx --test src/features/tabletop-operations/*.test.ts",
    "validate:tabletop-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/tabletop-operations-db.test.ts",
    "validate:combat-aid-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/combat-aid-db.test.ts",
    "validate:tabletop-runtime-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/tabletop-runtime-integration-db.test.ts",
    "validate:tabletop-closeout-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/tabletop-closeout-db.test.ts",
    "validate:tabletop-roll-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/tabletop-roll-runtime-db.test.ts",
    "validate:tabletop-session-closeout-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/tabletop-session-closeout-db.test.ts",
    "validate:tabletop-player-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/tabletop-player-encounter-db.test.ts",
    "validate:tabletop-player-browser": "node --conditions=react-server --import tsx scripts/tabletop-player-encounter-browser.test.ts",
    "validate:random": "tsx --test src/features/characters/random-character.test.ts",
    "validate:realms": "tsx --test src/features/characters/*.test.ts",
    "validate:active-state": "tsx --test src/features/active-state/*.test.ts",
    "validate:active-effects": "tsx --test src/features/active-state/active-effects.test.ts",
    "validate:active-mana": "tsx --test src/features/active-state/active-mana*.test.ts",
    "validate:mechanical-effects": "tsx --test src/features/mechanical-effects/*.test.ts",
    "validate:item-runtime": "tsx --test src/features/items/*.test.ts",
    "validate:item-ownership": "tsx --test src/features/items/item-ownership*.test.ts",
    "validate:item-use": "tsx --test src/features/items/item-use*.test.ts",
    "validate:item-charge": "tsx --test src/features/items/item-charge.test.ts",
    "validate:equipment-state": "tsx --test src/features/items/equipment-state.test.ts",
    "validate:spell": "tsx --test src/features/spell-construction/spell-integration.test.ts",
    "validate:spell-effects": "tsx --test src/features/spell-construction/mechanical-effects-adapter.test.ts",
    "validate:spell-runtime": "tsx --test src/features/characters/character-spell-runtime.test.ts",
    "validate:runtime-schema": "node scripts/verify-runtime-foundation-schema.mjs",
    "validate:runtime-db": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/runtime-foundation-db.test.ts",
    "db:seed:runtime-dev": "tsx scripts/seed-runtime-foundation-dev.ts",
    "db:backfill:creature-hp": "tsx scripts/backfill-creature-hp.ts",
    "audit:firearm-skills": "node scripts/audit-firearm-skills.mjs",
    "db:import:canon": "node scripts/import-ststandalone-skills.mjs && node scripts/import-ststandalone-canon.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
